# --- 스네이크 게임 로직 함수들 ---
def place_food():
    global food
    x = random.randint(0, (WIDTH - CELL_SIZE) // CELL_SIZE) * CELL_SIZE
    y = random.randint(0, (HEIGHT - CELL_SIZE) // CELL_SIZE) * CELL_SIZE
    food = (x, y)


def draw():
    canvas.delete("all")
    for x, y in snake:
        canvas.create_rectangle(x, y, x + CELL_SIZE, y + CELL_SIZE, fill="green")
    if food:
        canvas.create_oval(food[0], food[1], food[0] + CELL_SIZE, food[1] + CELL_SIZE, fill="red")


def move():
    global snake, game_running, snake_timer_id
    if not game_running:
        return

    head_x, head_y = snake[0]

    if direction == "Up":
        head_y -= CELL_SIZE
    elif direction == "Down":
        head_y += CELL_SIZE
    elif direction == "Left":
        head_x -= CELL_SIZE
    elif direction == "Right":
        head_x += CELL_SIZE

    new_head = (head_x, head_y)

    if (head_x < 0 or head_x >= WIDTH or head_y < 0 or head_y >= HEIGHT or new_head in snake):
        game_over()
        return

    snake.insert(0, new_head)

    if new_head == food:
        place_food()
    else:
        snake.pop()

    draw()
    snake_timer_id = root.after(SPEED, move)

def change_direction(event):
    global direction
    new_dir = event.keysym
    opposites = {"Up": "Down", "Down": "Up", "Left": "Right", "Right": "Left"}
    if new_dir in opposites and opposites[new_dir] != direction:
        direction = new_dir

def game_over():
    global game_running
    game_running = False
    canvas.create_text(WIDTH / 2, HEIGHT / 2, text="GAME OVER", fill="white", font=("Arial", 24))

# 게임 초기화 및 시작 함수
def start_snake_game():
    global snake, direction, game_running
    stop_snake_game()

    snake = [(100, 100), (80, 100), (60, 100)]
    direction = "Right"
    game_running = True

    place_food()
    draw()
    move()

# 게임 정지
def stop_snake_game():
    global game_running, snake_timer_id
    game_running = False
    if snake_timer_id:
        root.after_cancel(snake_timer_id)  # 예약된 move 함수 취소
        snake_timer_id = None

root.bind("<KeyPress>", change_direction)

