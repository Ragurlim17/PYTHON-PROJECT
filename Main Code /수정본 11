def start_actual_snake():
    global reward, current_food
    reward = False 
    current_food = 0
    
    snake_label.config(text="")
    
    # 1. 먼저 뱀 게임용 캔버스를 생성합니다. (test2 내부에서 canvas를 생성함)
    test2.start_snake_game(page5, update_food_label)
    
    # 2. ⭐ 캔버스가 배치된 직후, 그 위에 food_label이 올라오도록 다시 배치(또는 맨 위로 올림)합니다.
