def update_exp_display():
    label_level.config(text=f"레벨 {current_level}  |  경험치 {current_exp}/{max_exp}")
    exp_ratio = min(current_exp / max_exp, 1)
    canvas_game.coords(level_bar, 0, 0, exp_ratio * bar_max_width, 18)


def update_health_display():
    label_health.config(text=f"체력 {health}/100")
