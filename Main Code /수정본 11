def select_cat(cat_id):
    global selected_cat_id
    selected_cat_id = cat_id
    label_text.config(text=f"{cat_id}번 고양이를 선택했습니다.")
    update_cat_image()
    root.after(900, lambda: show_frame(page2))


def gain_experience(page, exp):
    global current_exp, current_level, max_exp
    
    current_exp += exp
    leveled_up = False

    while current_exp >= max_exp:
        current_exp -= max_exp
        current_level += 1
        max_exp += 100
        leveled_up = True

    if leveled_up:
        feed_status_label.config(text="레벨이 올랐습니다.")
        if page == page3 and current_level >= 5:
            root.after(2000, show_game_clear)

    update_exp_display()
    update_cat_image()


def change_health(amount):
    global health
    health = max(0, min(100, health + amount))
    update_health_display()


def feed_cat():
    if health >= 100:
        feed_status_label.config(text="이미 체력이 가득합니다.")
    else:
        change_health(FEED_HEALTH_GAIN)
        feed_status_label.config(text=f"밥을 먹고 체력이 올랐습니다! (+{FEED_HEALTH_GAIN})")

    mood_label.config(text="기분  든든함  |  간식  만족")
    root.after(1800, lambda: feed_status_label.config(text=""))


def give_reward(page, exp, damage):
    global health
    
    if health >= 100 and damage > 0:
        feed_status_label.config(text="이미 체력이 가득합니다.")
    elif health == 0 and damage < 0:
        feed_status_label.config(text="체력이 0입니다.")
    else:
        gain_experience(page, exp)
        change_health(damage)
        
        if page3 == page:
            feed_status_label.config(text=f"놀고 경험치를 획득했습니다! (+{exp})")
        elif page == page5:
            snake_label.config(text=f'미니 게임 후에 경험치를 획득했습니다! (+{exp})')


