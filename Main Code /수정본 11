        root.after(2000, show_game_clear)

def show_game_clear():
    width = root.winfo_width()
    height = root.winfo_height()

    overlay = tk.Canvas(page3, width=width, height=height, highlightthickness=0)
    overlay.place(x=0, y=0)
    overlay.create_rectangle(0, 0, width, height, fill="gray", stipple="gray50")
    overlay.create_text(width//2, height//2, text="게임 클리어!", font=("맑은 고딕", 30, "bold"), fill="white")

def make_button(parent, text, command, bg, fg=TEXT, width=160, height=48):
    return tk.Button(
        parent,
        text=text,
        font=(FONT, 14, "bold"),
        bg=bg,
        fg=fg,
        activebackground=bg,
        relief="flat",
        cursor="hand2",
        command=command,
        width=0,
        height=0,
    )


def load_cat_images():
    global cat_images, cat_evolved_images

    sources = {
        1: "아기 검정 고양이.png",
        2: "아기 치즈 고양이.png",
        3: "아기 흰 고양이.png",
        4: "중간 검정 고양이.png",
        5: "중간 치즈 고양이.png",
        6: "중간 흰 고양이.png",
        7: "큰 검정 고양이.png",
        8: "큰 치즈 고양이.png",
        9: "큰 흰 고양이.png"
    }

    try:
        for cat_id, path in sources.items():
            base = Image.open(path).convert("RGBA")
            select_img = base.resize((150, 150))
            normal_img = base.resize((210, 210))

            evolved = ImageEnhance.Color(normal_img).enhance(1.35)
            evolved = ImageEnhance.Brightness(evolved).enhance(1.12)

            cat_images[(cat_id, "select")] = ImageTk.PhotoImage(select_img)
            cat_images[(cat_id, "normal")] = ImageTk.PhotoImage(normal_img)
            cat_evolved_images[cat_id] = ImageTk.PhotoImage(evolved)
    except FileNotFoundError as error:
        messagebox.showerror("이미지 오류", f"필요한 이미지 파일이 없습니다.\n{error.filename}")
        root.destroy()


def selected_cat_image():
    if current_level < 3:
        return cat_evolved_images[selected_cat_id]
    elif current_level < 5:
        return cat_evolved_images[selected_cat_id+3]
    else:
        return cat_evolved_images[selected_cat_id+6]


