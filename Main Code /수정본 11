    # 3. 마찬가지로 snake_label도 가려지지 않게 맨 위로 올립니다.
    snake_label.place(x=150, y=500, width=400, height=30)
    snake_label.tkraise()
    
    root.update_idletasks()
    
    # 백그라운드 모니터링 루프 시작
    snake_reward_monitor()


def snake_reward_monitor():
    global reward, current_food
    
    # 이미 15개를 채워 보상이 나갔다면 루프를 불필요하게 돌리지 않고 탈출합니다.
    if reward:
        return
        
    # test2의 실시간 구동 상태만 모니터링하며 루프를 안전하게 동기화합니다.
    if test2.game_state.get("running", False):
        root.after(100, snake_reward_monitor)

