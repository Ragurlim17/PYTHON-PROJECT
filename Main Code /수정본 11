# 📌 실시간 점수 반영 및 15개 보상 즉시 처리를 담은 핵심 콜백 함수
def update_food_label(score):
    global current_food, reward
    current_food = score
    
    # UI에 텍스트를 반영하고 엔진에 즉시 새로 그리도록 강제 명령합니다.
    food_label.config(text=f"현재 먹은 음식 개수 : {current_food}")
    root.update_idletasks()
    
    # 15개 도달 시 보상 지급 후 게임 강제 종료
    if current_food >= 15 and not reward:
        reward = True
        give_reward(page5, 30, -40)
        test2.stop_snake_game()
    
    
