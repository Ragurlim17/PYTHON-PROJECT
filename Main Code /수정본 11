    cat_char.config(image=selected_cat_image())
    if current_level < 3: 
        evolution_label.config(text=f"Lv.3 진화까지 {3 - current_level}레벨")
    elif 3 <= current_level <= 5:
        evolution_label.config(text=f"Lv.5 진화까지 {5 - current_level}레벨")
        if current_level == 3 or current_level == 5:
